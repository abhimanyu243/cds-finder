# CDS View Finder settings. The app reads real environment variables; it does not load this file itself.
# Use it with:  uv run --env-file .env cds-finder serve   or   docker run --env-file .env ...

# Folder with CDS_FIELD_ORIGIN, IXTRCTNENBLDVW and (recommended) DD03N files
CDS_FINDER_DATA_DIR=data
# SQLite file with the table mapping and its history (created on first start). Back it up.
CDS_FINDER_DB_PATH=data/cds_finder.db
CDS_FINDER_HOST=127.0.0.1
CDS_FINDER_PORT=8000
# DEBUG, INFO, WARNING or ERROR
CDS_FINDER_LOG_LEVEL=INFO
# true: one JSON object per log line, for log collectors
CDS_FINDER_LOG_JSON=false
# false hides the interactive API documentation at /api/docs
CDS_FINDER_DOCS_ENABLED=true
# Logo for the header: an official logo file (SVG or PNG). Default: brand-logo.svg/.png in the data folder,
# otherwise the bundled Deloitte logo
# CDS_FINDER_BRAND_LOGO=data/brand-logo.svg
